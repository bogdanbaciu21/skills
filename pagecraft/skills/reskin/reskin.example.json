{
  "_comment": "Two shapes of reskin.json. Copy ONE to your repo root as reskin.json and edit. See SKILL.md.",

  "_example_bespoke (LJB-style: run the repo's own applier)": {
    "design_system": {
      "source": ".claude/skills/ljbcpa-design",
      "tokens_css": "colors_and_type.css",
      "assets": "assets"
    },
    "served_root": "brian-portal",
    "assets_target": "assets/ljb-brand",
    "framed_marker": "class=\"brand-nav\"",
    "apply_command": "python3 brian-portal/scripts/apply-brand-frame-v3.py {page} \"{eyebrow}|{headline_pre}|{headline_em}|{subhead}|{page_label}\"",
    "pages": [
      { "path": "brian-portal/use-cases/uc-01.html", "eyebrow": "use case", "headline_pre": "Document extraction", "headline_em": "at scale", "subhead": "What it does, what it costs, when to use it.", "page_label": "UC-01" }
    ]
  },

  "_example_generic (frame templates: built-in injector)": {
    "design_system": {
      "source": ".claude/skills/acme-design",
      "tokens_css": "colors_and_type.css",
      "assets": "assets",
      "frame": "frame"
    },
    "served_root": ".",
    "assets_target": "assets/brand",
    "framed_marker": "class=\"brand-nav\"",
    "pages": [
      { "path": "index.html", "eyebrow": "overview", "headline_pre": "The platform", "headline_em": "", "subhead": "One line of deck copy.", "page_label": "Home" },
      { "path": "pricing.html", "eyebrow": "plans", "headline_pre": "Simple pricing", "headline_em": "", "subhead": "Three tiers, no surprises.", "page_label": "Pricing" }
    ]
  }
}
