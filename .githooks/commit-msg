#!/usr/bin/env bash
# .githooks/commit-msg  --  issue-driven-workflow gate (HARNESS-AGNOSTIC)
#
# Architectural decision (Dan, 2026-06-19): ALL work routes through GitHub
# issues. This hook is the ONE enforcement point that fires regardless of
# harness (Claude/Codex/Cursor/human) or machine (Mac/VPS/GEX44), because git
# hooks run under every committer.
#
# Policy = "hard for humans, exempt automation". The distinguishing signal is the
# EXECUTION CONTEXT, not the message text (cron commits use Dan's own git
# identity AND varied messages, so neither author nor prefix reliably separates
# them):
#   * HARD mode (block when no issue ref): interactive human (a TTY) or an agent
#     session (Claude `CLAUDECODE`, Cursor, Codex markers).
#   * SOFT mode (warn, never block): unattended automation (cron/launchd/systemd
#     have no TTY and no agent markers). This is what keeps the always-on VPS
#     pipeline from breaking when it pulls this hook.
# Override anytime with WORK_ISSUE_ENFORCE=hard|soft|off.
#
# A commit is ALLOWED in either mode when it references an issue (#123 / (#123) /
# a work ticket like WORK-389), carries [skip-issue]/[ops], is a merge/revert/
# rebase replay, matches a known automation subject prefix, or comes from a bot.
# Deliberate one-off bypass:  git commit --no-verify

MSG_FILE="$1"
[ -z "$MSG_FILE" ] && exit 0
[ -f "$MSG_FILE" ] || exit 0

FULL="$(grep -vE '^[[:space:]]*#' "$MSG_FILE" 2>/dev/null || true)"
SUBJECT="$(printf '%s\n' "$FULL" | grep -vE '^[[:space:]]*$' 2>/dev/null | head -1 || true)"
[ -z "$SUBJECT" ] && exit 0

# ---- Allow conditions (apply in both modes) --------------------------------
allow() { exit 0; }

# 1) Escape hatch
printf '%s' "$FULL" | grep -qiE '\[(skip-issue|no-issue|ops|cron|automation)\]' && allow
# 2) Issue reference / work-ticket id
printf '%s' "$FULL" | grep -qE '#[0-9]+' && allow
printf '%s' "$FULL" | grep -qE '\b(WORK|LEARN|DEC|AGNT|OPS|UX|GPU|GROW|SKILL|FIN|HLTH|LIFE|DATA|SEC|INFRA)-[0-9]+\b' && allow
# 3) Merge / revert / in-progress rebase or cherry-pick replay
case "${GIT_REFLOG_ACTION:-}" in *rebase*|*merge*|*cherry-pick*|*revert*) allow ;; esac
GITDIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
{ [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ] || \
  [ -f "$GITDIR/MERGE_HEAD" ] || [ -f "$GITDIR/CHERRY_PICK_HEAD" ]; } && allow
# 4) Known automation subject prefixes
AUTOMATION_RE='^(auto:|auto\(|cicd|corpus|VPS ambient|vps:|outlook auto-ingest|life-scan|Refresh life scan|insight-lock|skillopt|Merge|Revert|spread|vendor-spend|deps(:| )|bump |Bump |Update brain corpus|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2})'
printf '%s' "$SUBJECT" | grep -qiE "$AUTOMATION_RE" && allow
EXTRA_FILE="$(git rev-parse --show-toplevel 2>/dev/null)/.github/work-issue-exempt-prefixes"
if [ -f "$EXTRA_FILE" ]; then
  while IFS= read -r pat; do
    [ -z "$pat" ] && continue; case "$pat" in \#*) continue ;; esac
    printf '%s' "$SUBJECT" | grep -qiE "$pat" && allow
  done < "$EXTRA_FILE"
fi
# 5) Known bot/automation committer identities
AUTHOR_EMAIL="$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p')"
case "$AUTHOR_EMAIL" in
  *dependabot*|cursoragent@cursor.com|*"cursor[bot]"*|cicd-heal@dans-brain.local) allow ;;
esac

# ---- Determine enforcement mode --------------------------------------------
MODE="${WORK_ISSUE_ENFORCE:-}"
[ "$MODE" = "off" ] && exit 0
if [ -z "$MODE" ]; then
  if [ -t 0 ] || [ -t 2 ]; then MODE=hard                                   # human at a terminal
  elif [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}" ]; then MODE=hard  # Claude Code agent
  elif [ -n "${CURSOR_TRACE_ID:-}${CURSOR_SESSION_ID:-}${CURSOR_AGENT:-}" ]; then MODE=hard  # Cursor
  elif [ -n "${CODEX_SANDBOX:-}${CODEX_SESSION_ID:-}${CODEX_THREAD_ID:-}${OPENAI_CODEX:-}" ]; then MODE=hard  # Codex
  else MODE=soft                                                            # unattended automation
  fi
fi

if [ "$MODE" = "soft" ]; then
  echo "[commit-msg] note: no issue reference (unattended context; not blocking). Issue-driven workflow: prefer an issue ref / [ops] tag." >&2
  exit 0
fi

# ---- HARD: block -----------------------------------------------------------
cat >&2 <<'EOF'

  [commit-msg] BLOCKED -- issue-driven workflow (interactive human/agent commit)

  Every unit of work routes through a GitHub issue (Dan's 2026-06-19 rule).
  Your commit message has no issue reference and is not recognized automation.

  Fix one of these ways:
    1. Reference your session/work issue:  <subject>  (#123)
       Open one:  python3 bin/work_issue.py open --title "<task>" \
                      --harness claude|codex|cursor --repo <owner>/<repo>
    2. Use a work-ticket id (WORK-/LEARN-/DEC-/AGNT-/OPS-/...).
    3. Unattended automation: prefix the subject (auto:, cicd, ...) or add [ops].
    4. Deliberate one-off: git commit --no-verify

EOF
exit 1
